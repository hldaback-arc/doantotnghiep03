  created_at            DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF_staging_products_created_at")
  import_batches        import_batches @relation(fields: [batch_id], references: [id], onUpdate: NoAction, map: "FK_staging_products_batches")

