model staging_stores {
  id                String         @id(map: "PK_staging_stores") @default(dbgenerated("newsequentialid()"), map: "DF_staging_stores_id") @db.UniqueIdentifier
  batch_id          String         @db.UniqueIdentifier
  external_store_id String?        @db.NVarChar(200)
  raw_name          String?        @db.NVarChar(500)
  raw_address       String?
  raw_latitude      String?        @db.NVarChar(100)
  raw_longitude     String?        @db.NVarChar(100)
  row_no            Int
  status            String         @default("PENDING", map: "DF_staging_stores_status") @db.NVarChar(20)
  created_at        DateTime       @default(dbgenerated("sysutcdatetime()"), map: "DF_staging_stores_created_at")
  import_batches    import_batches @relation(fields: [batch_id], references: [id], onUpdate: NoAction, map: "FK_staging_stores_batches")

  @@unique([batch_id, row_no], map: "UQ_staging_stores_batch_row")
}

model store_products {
  id                String          @id(map: "PK_store_products") @default(dbgenerated("newsequentialid()"), map: "DF_store_products_id") @db.UniqueIdentifier
  store_id          String          @db.UniqueIdentifier
  product_id        String          @db.UniqueIdentifier
  price             Decimal         @db.Decimal(19, 2)
  available         Boolean?
  product_url       String?
  product_source_id String          @db.UniqueIdentifier
  source_product_id String?         @db.NVarChar(200)
  updated_at        DateTime
  active            Boolean         @default(true, map: "DF_store_products_active")
  created_at        DateTime        @default(dbgenerated("sysutcdatetime()"), map: "DF_store_products_created_at")
  deleted_at        DateTime?
  products          products        @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "FK_store_products_products")
  product_sources   product_sources @relation(fields: [product_source_id], references: [id], onUpdate: NoAction, map: "FK_store_products_sources")
  stores            stores          @relation(fields: [store_id], references: [id], onUpdate: NoAction, map: "FK_store_products_stores")
}

model store_source_mappings {
  id                String          @id(map: "PK_store_source_mappings") @default(dbgenerated("newsequentialid()"), map: "DF_store_source_mappings_id") @db.UniqueIdentifier
  store_id          String          @db.UniqueIdentifier
  product_source_id String          @db.UniqueIdentifier
  external_store_id String          @db.NVarChar(200)
  confidence        Decimal         @db.Decimal(5, 4)
  verified_at       DateTime?
  verified_by       String?         @db.UniqueIdentifier
  review_status     String          @default("PENDING", map: "DF_store_source_mappings_review") @db.NVarChar(20)
  created_at        DateTime        @default(dbgenerated("sysutcdatetime()"), map: "DF_store_source_mappings_created_at")
  users             users?          @relation(fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_store_source_mappings_reviewers")
  product_sources   product_sources @relation(fields: [product_source_id], references: [id], onUpdate: NoAction, map: "FK_store_source_mappings_sources")
  stores            stores          @relation(fields: [store_id], references: [id], onUpdate: NoAction, map: "FK_store_source_mappings_stores")

  @@unique([product_source_id, external_store_id], map: "UQ_store_source_mappings_external")
  @@unique([store_id, product_source_id], map: "UQ_store_source_mappings_store_source")
}

model stores {
  id                    String                  @id(map: "PK_stores") @default(dbgenerated("newsequentialid()"), map: "DF_stores_id") @db.UniqueIdentifier
  name                  String                  @db.NVarChar(200)
  store_type            String?                 @db.NVarChar(50)
  brand_name            String?                 @db.NVarChar(120)
  address               String                  @db.NVarChar(500)
  latitude              Decimal                 @db.Decimal(10, 7)
  longitude             Decimal                 @db.Decimal(10, 7)
  phone                 String?                 @db.NVarChar(30)
  website               String?
  active                Boolean                 @default(true, map: "DF_stores_active")
  created_at            DateTime                @default(dbgenerated("sysutcdatetime()"), map: "DF_stores_created_at")
  updated_at            DateTime                @default(dbgenerated("sysutcdatetime()"), map: "DF_stores_updated_at")
  deleted_at            DateTime?
  cart_items            cart_items[]
  price_history         price_history[]
  purchase_items        purchase_items[]
  store_products        store_products[]
  store_source_mappings store_source_mappings[]
}

model transactions {
  id               String     @id(map: "PK_transactions") @default(dbgenerated("newsequentialid()"), map: "DF_transactions_id") @db.UniqueIdentifier
  user_id          String     @db.UniqueIdentifier
  type             String     @db.NVarChar(10)
  category_id      String     @db.UniqueIdentifier
  amount           Decimal    @db.Decimal(19, 2)
  note             String?
  transaction_date DateTime
  purchase_id      String?    @db.UniqueIdentifier
  idempotency_key  String?    @db.NVarChar(100)
  status           String     @default("POSTED", map: "DF_transactions_status") @db.NVarChar(20)
  created_at       DateTime   @default(dbgenerated("sysutcdatetime()"), map: "DF_transactions_created_at")
  updated_at       DateTime   @default(dbgenerated("sysutcdatetime()"), map: "DF_transactions_updated_at")
  deleted_at       DateTime?
  categories       categories @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "FK_transactions_categories")
  purchases        purchases? @relation(fields: [purchase_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_transactions_purchases")
  users            users      @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "FK_transactions_users")
}

